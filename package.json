{
  "name": "yns-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "contract:lint": "spectral lint docs/contracts/backend-api-v1.yaml",
    "contract:verify": "node scripts/verify-contract.mjs",
    "contract:generate": "openapi-typescript docs/contracts/backend-api-v1.yaml -o src/api/generated/backend-api-v1.d.ts",
    "contract:check": "npm run contract:lint && npm run contract:verify && npm run contract:generate && git diff --exit-code -- src/api/generated/backend-api-v1.d.ts",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
